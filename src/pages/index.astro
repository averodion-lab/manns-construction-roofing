---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import SectionBg from '../components/SectionBg.astro';
import { SITE } from '../data/site';
import { CATEGORIES, getService } from '../data/services';
import { PROJECTS, PROJECT_CATEGORIES } from '../data/projects';
import type { IconName } from '../data/icons';

const trust: { icon: IconName; title: string; text: string }[] = [
  { icon: 'shield', title: 'Licensed & Insured', text: 'Professional, protected work on your property.' },
  { icon: 'award', title: 'Quality Work', text: 'Done right the first time, with attention to detail.' },
  { icon: 'check', title: 'Professional Service', text: 'Clear communication from estimate to cleanup.' },
  { icon: 'file', title: 'Free Estimates', text: 'A clear, written quote before work begins.' },
  { icon: 'storm', title: 'Storm Damage Assistance', text: 'Inspections, documentation, and restoration.' },
];

const storm = getService('storm-damage')!;
const featured = [PROJECTS[0], PROJECTS[3], PROJECTS[6]];
const catLabel = (id: string) => PROJECT_CATEGORIES.find((c) => c.id === id)?.label ?? id;
---
<Base title={SITE.name}>
  <!-- HERO -->
  <section class="hero hero--owner">
    <div class="hero-media hero-media--owner"><Img img="ownerHouse" eager sizes="100vw" width={1800} /></div>
    <div class="container">
      <p class="eyebrow">{SITE.location} · {SITE.status}</p>
      <h1>
        <span class="line">Quality Roofing</span>
        <span class="line">&amp; Construction</span>
        <span class="line accent">You Can Count On</span>
      </h1>
      <p class="lead">
        Roofing, remodeling, storm repair, and land work for homeowners across {SITE.serviceArea}. Call for a free estimate.
      </p>
      <div class="btn-row">
        <a class="btn btn--lg" href="/quote">Get a Free Quote <Icon name="arrow" /></a>
        <a class="btn btn--ghost btn--lg" href={SITE.phoneHref}><Icon name="phone" /> Call {SITE.phone}</a>
      </div>
      <p class="hero-secondary">
        <a class="link-arrow" href="#services" style="color:#fff">Explore Our Services <Icon name="arrow" /></a>
      </p>
    </div>
  </section>

  <!-- TRUST -->
  <section class="trust" aria-label="Why choose us">
    <div class="container">
      <div class="trust-grid">
        {trust.map((t, i) => (
          <div class="trust-item reveal" style={`--d:${i * 60}ms`}>
            <Icon name={t.icon} />
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="reveal">
          <p class="eyebrow">What we do</p>
          <h2>Roofing, remodeling, and land work.</h2>
        </div>
        <div class="reveal" style="--d:100ms">
          <p class="lead muted">
            From the roof to the kitchen to the back forty, Manns Construction &amp; Roofing handles roofing, remodeling, construction,
            concrete, tree removal, land clearing, and more. One licensed &amp; insured contractor for your whole property.
          </p>
          <a class="link-arrow" href="/services" style="margin-top:12px">View Our Services <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="grid grid--4">
        {CATEGORIES.map((c, i) => <ServiceCard category={c} index={i} />)}
      </div>
    </div>
  </section>


  <!-- ROOFING FEATURE -->
  <section class="section on-paper-2">
    <div class="container split">
      <div class="framed reveal">
        <Img img="roofTearOff" sizes="(min-width: 960px) 50vw, 100vw" />
              </div>
      <div class="reveal" style="--d:100ms">
        <p class="eyebrow">Roofing</p>
        <h2>Repairs, replacements, and new roofs.</h2>
        <p class="lead muted" style="margin-top:20px">
          Installation, replacement, repairs, inspections, and maintenance for shingle and metal roofs. We’ll tell you what your
          roof actually needs — and do the job right.
        </p>
        <ul class="checklist checklist--cols mt-l" style="margin-top:28px">
          {['Roof Repair', 'Roof Replacement', 'New Roof Installation', 'Roof Inspections', 'Leak Repair', 'Metal & Shingle Roofing'].map((x) => (
            <li><Icon name="check" />{x}</li>
          ))}
        </ul>
        <div class="btn-row" style="margin-top:32px">
          <a class="btn" href="/roofing">Learn More <Icon name="arrow" /></a>
          <a class="btn btn--ink" href="/quote?service=Roofing">Get a Roofing Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- STORM -->
  <section class="section on-dark has-photo">
    <SectionBg img="storm" position="center 30%" />
    <div class="container">
      <div class="section-head section-head--split">
        <div class="reveal">
          <p class="eyebrow">Storm Damage</p>
          <h2>Storm damage? <span class="accent">We can help.</span></h2>
        </div>
        <div class="reveal" style="--d:100ms">
          <p class="lead muted">
            Wind, hail, and falling limbs can damage roofs, siding, and gutters in ways you can’t see from the ground. We inspect,
            document, and restore — and help guide you through the process.
          </p>
          <div class="btn-row" style="margin-top:24px">
            <a class="btn" href="/quote?service=Storm%20Damage">Request Storm Inspection</a>
            <a class="btn btn--ghost" href={SITE.phoneHref}><Icon name="phone" /> {SITE.phone}</a>
          </div>
        </div>
      </div>
      <ol class="steps">
        {storm.process!.map((s, i) => (
          <li class="reveal" style={`--d:${i * 90}ms`}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CONSTRUCTION FEATURE -->
  <section class="section">
    <div class="container split split--reverse">
      <div class="framed reveal">
        <Img img="framing" sizes="(min-width: 960px) 50vw, 100vw" />
              </div>
      <div class="reveal" style="--d:100ms">
        <p class="eyebrow">Construction</p>
        <h2>From additions to pole barns.</h2>
        <p class="lead muted" style="margin-top:20px">
          Home additions, custom kitchens and baths, painting, flooring, decks, pole barns, and demolition. Tell us what you want to build and
          we’ll give you a clear plan and a clear price.
        </p>
        <div class="grid" style="margin-top:28px;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))">
          {[
            ['Home Additions', '/home-additions', 'home'],
            ['Kitchen & Bath', '/kitchen-bathroom-remodeling', 'droplet'],
            ['Painting & Flooring', '/painting', 'brush'],
            ['Decks', '/decks', 'layers'],
            ['Pole Barns', '/pole-barns', 'barn'],
            ['Demolition & Cleanup', '/demolition', 'hammer'],
          ].map(([l, h, ic]) => (
            <a class="feature" href={h} style="grid-template-columns:auto 1fr;align-items:center;padding:14px 16px;gap:14px">
              <span class="ic" style="width:40px;height:40px;margin:0"><Icon name={ic as IconName} /></span>
              <strong>{l}</strong>
            </a>
          ))}
        </div>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn" href="/construction">Talk to Us About Your Project <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section on-paper-2">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="reveal">
          <p class="eyebrow">Projects</p>
          <h2>Recent work</h2>
        </div>
        <div class="reveal" style="--d:100ms">
          <p class="lead muted">Roofing, siding, construction, decks, concrete, and storm restoration projects.</p>
          <a class="btn btn--ink" href="/projects" style="margin-top:20px">View Our Projects <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="projects">
        {featured.map((p, i) => (
          <a class="project reveal" href={`/projects#${p.category}`} style={`--d:${i * 80}ms`}>
            <Img img={p.images[0]} width={800} max={1200} sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw" />
            <span class="meta">
              <span class="cat">{catLabel(p.category)}</span>
              <h3>{p.title}</h3>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading="Ready to start your project?" />
</Base>
