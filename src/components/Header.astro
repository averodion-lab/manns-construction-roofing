---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { NAV, SITE } from '../data/site';
import { SERVICES } from '../data/services';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href);
const menuServices = SERVICES.map((s) => ({ label: s.name, href: `/${s.slug}` }));
---
<a class="skip-link" href="#main">Skip to content</a>

<div class="utility">
  <div class="container">
    <ul>
      <li><Icon name="shield" /> {SITE.status}</li>
      <li><Icon name="file" /> Free Estimates</li>
      <li><Icon name="storm" /> Storm Damage Assistance</li>
    </ul>
    <a href={SITE.phoneHref}><Icon name="phone" /> Call {SITE.phone}</a>
  </div>
</div>

<header class="site-header">
  <div class="container">
    <Logo />

    <nav class="nav" aria-label="Main">
      <ul>
        {NAV.map((item) =>
          item.menu ? (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label} <Icon name="chevron" />
              </a>
              <ul class="nav-menu">
                {menuServices.map((s) => (
                  <li><a href={s.href}>{s.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="header-cta">
      <a class="header-phone" href={SITE.phoneHref} aria-label={`Call ${SITE.phone}`}>
        <Icon name="phone" /><span>{SITE.phone}</span>
      </a>
      <a class="btn" href="/quote">Get a Quote</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="drawer" data-menu-open>
        <Icon name="menu" /><span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" data-open="false" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="drawer-top">
    <Logo />
    <button class="menu-toggle" type="button" data-menu-close>
      <Icon name="close" /><span class="sr-only">Close menu</span>
    </button>
  </div>
  <div class="drawer-cta" style="margin:20px 0 0">
    <a class="btn btn--lg btn--block" href={SITE.phoneHref}><Icon name="phone" /> Call Now — {SITE.phone}</a>
  </div>
  <nav aria-label="Mobile">
    <ul>
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label} <Icon name="arrow" />
          </a>
          {item.menu && (
            <div class="sub">
              {menuServices.map((s) => <a href={s.href}>{s.label}</a>)}
            </div>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <div class="drawer-cta">
    <a class="btn btn--light btn--lg btn--block" href="/quote">Get a Free Quote <Icon name="arrow" /></a>
  </div>
</div>

<script>
  const drawer = document.getElementById('drawer')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = drawer.querySelector<HTMLButtonElement>('[data-menu-close]')!;

  function setOpen(open: boolean) {
    drawer.dataset.open = String(open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('drawer-open', open);
    (open ? closeBtn : openBtn).focus();
  }

  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  drawer.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.dataset.open === 'true') setOpen(false);
  });
  matchMedia('(min-width: 1360px)').addEventListener('change', (e) => {
    if (e.matches && drawer.dataset.open === 'true') setOpen(false);
  });
</script>
